# ─── Application ──────────────────────────────────
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── PostgreSQL Database ──────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/xynvora_ai
POSTGRES_MAX_CONNECTIONS=20
POSTGRES_IDLE_TIMEOUT_MS=30000

# ─── Supabase Integration ────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=xynvora-assets

# ─── Authentication & Security ───────────────────
JWT_SECRET=xynvora_development_jwt_secret_change_in_production_super_secure_key
JWT_EXPIRES_IN=7d
COOKIE_SECRET=xynvora_cookie_secret_key_32_chars_long

# ─── OpenAI AI Services ──────────────────────────
OPENAI_API_KEY=sk-placeholder-openai-key

# ─── Email (SMTP) ────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contact@xynvora.ai
SMTP_PASS=your-app-password
EMAIL_FROM_NAME="Xynvora AI"

